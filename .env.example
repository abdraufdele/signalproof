# Optional local development values. Do not commit .env.
# In PayBox, use brokered header credentials instead of embedding these in code.
COINGECKO_DEMO_API_KEY=YOUR_COINGECKO_DEMO_API_KEY
ZEROX_API_KEY=YOUR_ZEROX_API_KEY
# Public address only; never put a private key or seed phrase here.
PUBLIC_WALLET_ADDRESS=YOUR_PUBLIC_BASE_WALLET_ADDRESS
TOKEN_ADDRESS=0x4200000000000000000000000000000000000006
RESEARCH_MAX_USDC=0.10
