# Curated repository: unlisted root content stays local.
/*
!/.gitignore
!/.env.example
!/README.md
!/docs/
!/signalproof-logo/
!/plugin/
/plugin/*
!/plugin/package.json
!/plugin/pnpm-lock.yaml
!/plugin/pnpm-workspace.yaml
!/plugin/tsconfig.json
!/plugin/paybox-plugin.json
!/plugin/starter-version.json
!/plugin/starter-manifest.json
!/plugin/requirements-reference.md
!/plugin/README.md
!/plugin/src/
!/plugin/tests/
!/plugin/scripts/
!/scripts/
/scripts/*
!/scripts/metrics.mjs
!/scripts/metrics.test.mjs
!/scripts/evidence.mjs
!/scripts/evidence.test.mjs
!/scripts/study-design.mjs
!/scripts/study-score.test.mjs
!/scripts/score-study.mjs
# Secrets and machine/session state, at any depth.
**/.env
**/.env.*
!/.env.example
**/*credentials*.json
**/*secrets*.json
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/auth.json
**/.npmrc
**/.netrc
**/node_modules/
**/.venv/
**/venv/
**/dist/
**/build/
**/coverage/
**/.cache/
**/.tools/
**/.codex/
**/.agents/
**/browser/
**/sessions/
**/*storage-state*.json
**/*cookie*.json
**/*.log
**/*.tsbuildinfo
**/__pycache__/
**/*.pyc
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/*~
**/*.swp

# Temporary preparation scripts, anywhere in the repository.
**/.tmp/
